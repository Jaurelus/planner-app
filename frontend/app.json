{
  "expo": {
    "name": "my-expo-app",
    "slug": "my-expo-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/dayflow-icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "orientation": "portrait",
    "icon": "./assets/dayflow-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/dayflow-logotype.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.my-expo-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/dayflow-icon.png",
        "backgroundColor": "#8B62C4"
      }
    },
    "extra": {
      "eas": {
        "projectId": "82b5b772-9c0a-4791-b546-7e0d8a006d18"
      }
    },
    "owner": "jaurelus12"
  }
}
